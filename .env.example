# TOR Radar — copy to `.env` and fill in there:   cp .env.example .env
#
# NEVER put a real credential in THIS file — it is committed and pushed to
# GitHub. Real values go in `.env` (gitignored). Key files go in ./secrets/
# (gitignored); variables here hold their PATH. `KEY=` with nothing = not set.
#
# Comments go on their OWN line, never after a value: Docker Compose keeps
# `KEY=   # note` as the literal text "# note".
#
# Every other setting has a working default, documented in
# apps/api/src/core/config.ts. Add one here only to change it.

# --- Required: the API will not start without these --------------------------
# If an Atlas mongodb+srv:// address fails with `querySrv ECONNREFUSED`, use
# Atlas's "standard connection string" (mongodb://host1,host2,host3/...).
MONGO_URL=mongodb://mongo:27017/tor_radar
APP_ORIGIN=http://localhost:3000
GCS_BUCKET=tor-raw

# SECRETS. Generate: openssl rand -base64 48 (session, 32+ chars) and
# openssl rand -hex 32 (each key; keys are comma-separated).
SESSION_SECRET=
INTAKE_API_KEYS=
# The web server's key to the admin API. The browser never sees it.
ADMIN_API_KEYS=
# Admin screen password — a stopgap until admins sign in with their own
# accounts (TOR-199).
STAFF_ACCESS_SECRET=

# --- Storage ----------------------------------------------------------------
# Local: the Compose emulator. Real bucket: empty GCS_API_ENDPOINT and point
# GCS_CREDENTIALS at the DEDICATED storage service account's key — never the
# Vertex one.
GCS_API_ENDPOINT=http://localhost:4443
GCS_CREDENTIALS=

# --- Vertex AI (extraction; every call is billed) ----------------------------
# GOOGLE_APPLICATION_CREDENTIALS is a path, e.g. ./secrets/gcp-sa.json
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Email ------------------------------------------------------------------
# Local: Mailpit — inbox at http://localhost:8025, nothing leaves the machine.
# Production: your provider's SMTP URL (required there).
SMTP_URL=smtp://mail:1025

# --- Web --------------------------------------------------------------------
# Use http://localhost:4000 when running outside Docker Compose.
API_BASE_URL=http://api:4000

# --- Tests: never against the shared cloud ----------------------------------
# RUN_LIVE_VERTEX=1 runs the tests that make BILLED Vertex calls.
TEST_MONGO_URL=mongodb://localhost:27017/tor_radar_dev
TEST_GCS_API_ENDPOINT=http://localhost:4443
RUN_LIVE_VERTEX=

# --- Switches: off on purpose -----------------------------------------------
# Match emails stay off until match quality has been checked by hand.
NOTIFY_DISPATCH_ENABLED=false
# Area scoring stays off until extraction captures where the work is.
MATCH_AREA_SIGNAL_ENABLED=false
