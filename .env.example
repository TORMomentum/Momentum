# TOR Radar — copy to `.env` and fill in there:   cp .env.example .env
#
# NEVER put a real credential in THIS file — it is committed and pushed to
# GitHub. Real values go in `.env` (gitignored). Key files go in ./secrets/
# (gitignored); variables here hold their PATH. `KEY=` with nothing = not set.
#
# Comments go on their OWN line, never after a value: Docker Compose keeps
# `KEY=   # note` as the literal text "# note".
#
# Every other setting has a working default, documented in
# apps/api/src/core/config.ts. Add one here only to change it.

# --- Required: the API will not start without these --------------------------
# If an Atlas mongodb+srv:// address fails with `querySrv ECONNREFUSED`, use
# Atlas's "standard connection string" (mongodb://host1,host2,host3/...).
MONGO_URL=mongodb://mongo:27017/tor_radar?directConnection=true
APP_ORIGIN=http://localhost:3000
GCS_BUCKET=tor-raw

# SECRETS. Generate: openssl rand -base64 48 (session, 32+ chars) and
# openssl rand -hex 32 (each key; keys are comma-separated).
SESSION_SECRET=
# Session timeouts (ASVS V7.3). Absolute lifetime 7 days; idle timeout 30 minutes.
# lastSeenAt is written at most every SESSION_TOUCH_INTERVAL_MS (capped at half the idle timeout).
# SESSION_SINGLE_ACTIVE=true ends an account's other sessions at sign-in (V7.4.1); false allows several devices.
# SESSION_LIFETIME_MS=604800000
# SESSION_IDLE_TIMEOUT_MS=1800000
# SESSION_TOUCH_INTERVAL_MS=60000
# SESSION_SINGLE_ACTIVE=true
INTAKE_API_KEYS=
# The web server's key to the admin API. The browser never sees it.
ADMIN_API_KEYS=
# Admin screen password — a stopgap until admins sign in with their own
# accounts (TOR-199).
STAFF_ACCESS_SECRET=

# --- Storage ----------------------------------------------------------------
# Local: the Compose emulator. Real bucket: empty GCS_API_ENDPOINT and point
# GCS_CREDENTIALS at the DEDICATED storage service account's key — never the
# Vertex one.
GCS_API_ENDPOINT=http://localhost:4443
GCS_CREDENTIALS=
# The vendors' own files (TOR-218) — a bucket apart from the originals, because a vendor can delete theirs and
# the originals are never deleted. Create it like the originals bucket; the emulator does not create it.
# GCS_VAULT_BUCKET=tor-vault
# VAULT_MAX_FILE_BYTES=10485760
# VAULT_MAX_FILES=20
# An unfinished upload this old is cleared by the worker's reconcile pass.
# VAULT_PENDING_TTL_MS=3600000
# The web server reads VAULT_MAX_FILE_BYTES too (it refuses an upload past it, plus 1 MiB of multipart framing,
# before reading it): keep it equal to the API's.

# --- Vertex AI (extraction; every call is billed) ----------------------------
# GOOGLE_APPLICATION_CREDENTIALS is a path, e.g. ./secrets/gcp-sa.json
# Without a project and a credential FILE that exists, the extraction worker reads nothing: uploaded documents
# stay "queued" and the worker logs extraction_disabled. It never publishes a record it did not extract.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Email ------------------------------------------------------------------
# Local: Mailpit — inbox at http://localhost:8025, nothing leaves the machine.
# Production: your provider's SMTP URL (required there).
SMTP_URL=smtp://mail:1025

# --- Sign in with Google (TOR-315) --------------------------------------------
# Off until an OAuth client exists (docs/gcp-setup.md "Sign in with Google"). On, the id and secret are
# required. The redirect URI defaults to APP_ORIGIN + /api/auth/google/callback and must equal one of the
# "Authorised redirect URIs" on the OAuth client. The web server reads GOOGLE_OAUTH_ENABLED too (it shows or
# hides the button); Compose passes it to both.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=
# How long a sign-in attempt (and the consent step after a first Google sign-in) stays valid.
# OAUTH_TRANSACTION_TTL_MS=600000

# --- Breached-password check (TOR-320, ASVS V6.2.4) ---------------------------
# New passwords (register, reset, change) are refused when on the bundled common list (always checked) or seen in
# Have I Been Pwned. Only the first 5 hex chars of the SHA-1 are sent. If HIBP is down the password is accepted
# (the common list still applies) and breached_password_check_unavailable is logged. Set false to skip HIBP.
HIBP_ENABLED=true
# HIBP_API_URL=https://api.pwnedpasswords.com/range/
# HIBP_TIMEOUT_MS=3000
# A password seen at least this many times is refused.
# HIBP_MIN_COUNT=1

# --- Web --------------------------------------------------------------------
# Use http://localhost:4000 when running outside Docker Compose.
API_BASE_URL=http://api:4000
# Extra Content-Security-Policy sources for the web app (TOR-321), space-separated. Default none: the browser
# talks only to the web server itself.
# CSP_EXTRA_IMG_SRC=
# CSP_EXTRA_CONNECT_SRC=

# Real client address for rate limits (TOR-318). The web server reads the client from the incoming X-Forwarded-For -
# the entry just left of this many trusted hops - and sends the API ONE X-Forwarded-For with that address, replacing
# what arrived. 1 = behind Google's front end on Cloud Run; 0 = never forward.
# TRUSTED_PROXY_HOPS=0

# --- Rate limits (per client address, per minute) ---------------------------
# The API's trusted proxy hops, for Express `trust proxy`: false (default), a hop count, or an address list such as
# "loopback, uniquelocal". Never "true": the API refuses to start, as it would believe any caller's X-Forwarded-For.
# Compose keeps false because the API port is published. Requests through web share its socket bucket.
# Cloud Run sets 2 for its IAM-restricted API topology.
# TRUST_PROXY=false
# PUBLIC_SEARCH_RATE_LIMIT_PER_MIN=120
# DOCUMENT_RATE_LIMIT_PER_MIN=60
# CSV export of the filtered TOR list (TOR-69): rows in one file, files per client per minute.
# EXPORT_MAX_ROWS=5000
# EXPORT_RATE_LIMIT_PER_MIN=10
# Project stages from e-GP (TOR-205): the stages worker re-reads a project's stage table once per
# refresh, paced between projects, and backs off after three failed lookups in a row.
# STAGES_REFRESH_HOURS=24
# STAGES_REQUEST_DELAY_MS=2000
# STAGES_BACKOFF_MS=3600000
# STAGES_MAX_AGE_DAYS=180
# STAGES_BATCH=50
# STAGES_CLAIM_MS=900000
# STAGE_HISTORY_MAX=20
# Stage-change emails (TOR-239): a move older than this many days is never emailed, so the first
# dispatch after a vendor starts following, or after the worker was off, sends no backlog.
# STAGE_NOTIFY_LOOKBACK_DAYS=14
# Source health (TOR-87): an automatic source is "failing" after this many failed passes in a row, "stale" when
# not seen for this many hours. The extraction worker checks every SOURCE_CHECK_INTERVAL_MS and emails every
# admin once per problem and once on recovery; an idle stages worker reports it is alive every SOURCE_HEARTBEAT_MS.
# SOURCE_ALERT_FAILURES=3
# SOURCE_STALE_HOURS=48
# SOURCE_CHECK_INTERVAL_MS=3600000
# SOURCE_HEARTBEAT_MS=3600000
# National e-GP source (tools/import_national_egp_tors.mts, tools/backfill_egp_announced_dates.mts).
# NATIONAL_EGP_SERVICE_BASE=https://process5.gprocurement.go.th
# A project's dated stages (TOR-204), relative to the service base.
# NATIONAL_EGP_PROJECT_STAGES_PATH=/egp-oann10-service/pb/a-egp-allt-project/announcement/greenBook
# A project's winner announcement (TOR-221, tools/collect_egp_awards.mts): the template it names, and its PDF.
# NATIONAL_EGP_AWARD_TEMPLATE_PATH=/egp-approval-service/apv-common/infoApproveTemplate
# NATIONAL_EGP_AWARD_TEMPLATE_TYPE=W13
# NATIONAL_EGP_AWARD_PDF_PATH=/egp-template-service/dwnt/view-pdf-file
# NATIONAL_EGP_MAX_AWARD_BYTES=10485760
# AUTH_RATE_LIMIT_PER_IP=60
# AUTH_RATE_LIMIT_PER_EMAIL=10

# --- Logging ----------------------------------------------------------------
# Minimum severity on stdout: debug, info, warn or error. Default info.
LOG_LEVEL=info

# --- Tests: never against the shared cloud ----------------------------------
# RUN_LIVE_VERTEX=1 runs the tests that make BILLED Vertex calls.
TEST_MONGO_URL=mongodb://localhost:27017/tor_radar_dev?directConnection=true
TEST_GCS_API_ENDPOINT=http://localhost:4443
RUN_LIVE_VERTEX=

# --- Switches: off on purpose -----------------------------------------------
# Match emails stay off until match quality has been checked by hand.
NOTIFY_DISPATCH_ENABLED=false
# Area scoring stays off until extraction captures where the work is.
MATCH_AREA_SIGNAL_ENABLED=false
# Personalised score: what a consenting vendor viewed, saved, dismissed or prepared nudges their score (TOR-216).
# Off by default, and while off nothing is recorded. Weights, point value, cap and window are tunables in config.ts.
MATCH_BEHAVIOUR_ENABLED=false
# The web build reads the same variable to show the optional sign-up box, so rebuild web after changing it
# (docker compose build web). Compose passes it to the API, the worker and, as a build argument, to web.
# AI draft of a cover letter for a TOR (TOR-220): off by default. On, a vendor who asks sends their profile (work
# categories, areas, certificates, personnel roles, past projects), the TOR's extracted fields and the NAMES of their
# kept files to Vertex AI; the files themselves are never sent and the draft is not stored.
DRAFT_ENABLED=false
# DRAFT_RATE_PER_HOUR=10
# DRAFT_TIMEOUT_MS=45000
# DRAFT_MAX_OUTPUT_TOKENS=8192
# DRAFT_TEMPERATURE=0.3
# BEHAVIOUR_WEIGHT_VIEW=1
# BEHAVIOUR_WEIGHT_SAVE=3
# BEHAVIOUR_WEIGHT_PREPARE=5
# BEHAVIOUR_WEIGHT_DISMISS=-3
# BEHAVIOUR_POINT_VALUE=0.01
# BEHAVIOUR_MAX_ADJUST=0.1
# BEHAVIOUR_WINDOW_DAYS=90
# Ask Gemini where the work is done (the input to area matching). Off by default: it changes the
# prompt and schema the T_LOW/T_HIGH thresholds were measured on, so re-run the benchmark before turning it on.
EXTRACT_WORK_LOCATION_ENABLED=false
# Ask Gemini for the evaluation method with its weights, and the documents a bidder must show. Off by
# default for the same reason: it changes the prompt and schema the thresholds were measured on.
EXTRACT_BIDDING_FIELDS_ENABLED=false
# Provenance boxes: Document AI reads each document so the review screen can show where a value came from.
# Off by default; every run bills Document AI pages. Document AI is multi-region only ("us" or "eu").
OCR_ENABLED=false
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=
# OCR_MAX_PAGES=15
# Free-text work types compared by embedding instead of a substring. Off by default; spends model calls.
EMBEDDINGS_ENABLED=false
# EMBEDDING_MODEL=text-multilingual-embedding-002
# EMBEDDING_LOCATION=us-central1
# EMBEDDING_MIN_SIMILARITY=0.75

# Keyword search through Atlas Search (lucene.thai). Needs Atlas or mongodb-atlas-local;
# on a plain mongod leave it false and search falls back to a substring match.
SEARCH_ATLAS_ENABLED=false
# SEARCH_INDEX_NAME=tors_text
# SEARCH_MAX_HITS=1000
# Largest "at least N days left to prepare" a search accepts (minDaysLeft).
# SEARCH_MAX_DAYS_LEFT=365
# Open TORs closing in fewer days than this are listed after those with time to prepare (0 = off).
# SEARCH_MIN_PREP_DAYS=5

# Winners by category (TOR-280): how many of the most frequent winners the top winners' share counts.
# A category needs PEER_MIN_N awarded projects (default 8) before it is compared.
# COMPETITION_TOP_WINNERS=3
