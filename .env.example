# =============================================================================
#  TOR Radar — environment template
# =============================================================================
#
#  Copy this file to `.env` and fill in YOUR values there:
#
#      cp .env.example .env
#
#  ▶ NEVER put a real credential in THIS file. It is committed to git and
#    pushed to GitHub; anything here is published, and stays in the history
#    after it is deleted. `.env` is gitignored and never leaves your machine.
#
#  ▶ Key FILES (service-account JSON) go in ./secrets/, which is gitignored.
#    The variables below hold their PATH, never their contents.
#
#  ▶ A line written `KEY=` with nothing after it means "not set".
#
#  Sections, in order of how soon you need them:
#    1. Required — the API refuses to start without these
#    2. Cloud services — each one switches a real service on
#    3. Web app
#    4. Tests — keep them off the shared cloud
#    5. Switches — off by default, on purpose
#    6. Tuning — defaults live in code; uncomment only to change one
#    7. Tools
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED — the API will not start without every one of these
# -----------------------------------------------------------------------------

# MongoDB. Inside Docker Compose this is the `mongo` service, as below.
# For MongoDB Atlas, paste the connection string from the Atlas console.
#   If the API reports `querySrv ECONNREFUSED` for a mongodb+srv:// address,
#   your network's DNS will not do the SRV lookup Node needs: use Atlas's
#   "standard connection string" (mongodb://host1,host2,host3/...) instead.
MONGO_URL=mongodb://mongo:27017/tor_radar

# SECRET. Signs session cookies. At least 32 characters, unique per
# environment. Generate one:  openssl rand -base64 48
SESSION_SECRET=

# The public address of the web app, with no path. Account requests that
# change anything must come from here.
APP_ORIGIN=http://localhost:3000

# SECRET. Comma-separated keys for the machine-to-machine intake API.
# Generate each:  openssl rand -hex 32
INTAKE_API_KEYS=

# SECRET. Comma-separated keys the web server uses to call the admin API.
# The browser never sees these.
ADMIN_API_KEYS=

# SECRET. Shared password for the admin screens (a stopgap until admins sign
# in with their own accounts — TOR-199). Empty means nobody can sign in.
STAFF_ACCESS_SECRET=

# The bucket original documents are stored in. Required in every setup.
GCS_BUCKET=tor-raw


# -----------------------------------------------------------------------------
# 2. CLOUD SERVICES — each one is optional, and switches a real service on
# -----------------------------------------------------------------------------

# --- Object storage: Google Cloud Storage ------------------------------------
# Local / CI: the fake-gcs-server emulator in Compose. Set this, leave
# GCS_CREDENTIALS empty. The API refuses the emulator when NODE_ENV=production.
GCS_API_ENDPOINT=http://localhost:4443
# Real bucket: leave GCS_API_ENDPOINT empty and point this at the DEDICATED
# storage service account's key file. Never the Vertex AI key — one leaked key
# must not carry both powers.
GCS_CREDENTIALS=

# --- Google Cloud project (needed by Vertex AI and by a real bucket) ---------
GOOGLE_CLOUD_PROJECT=

# --- Vertex AI: Gemini reads and extracts each TOR ---------------------------
# PATH to the Vertex service account's key file, e.g. ./secrets/gcp-sa.json.
# Empty means extraction is unavailable; the rest of the app still runs.
# Every extraction is a BILLED model call.
GOOGLE_APPLICATION_CREDENTIALS=
GEMINI_MODEL=gemini-3.5-flash
# Gemini 3.x Flash is served from "global" only.
VERTEX_LOCATION=global

# --- Document AI: Thai OCR for scanned documents -----------------------------
# NOT USED YET — nothing in the pipeline calls Document AI (TOR-202). Kept so
# the processor is recorded in one place for when it is wired in.
# Document AI is multi-region only: "us" or "eu".
# DOCAI_LOCATION=us
# DOCAI_PROCESSOR_ID=

# --- Email ------------------------------------------------------------------
# Local / CI: the Mailpit container in Compose — every message lands in its web
# inbox at http://localhost:8025 and nothing leaves the machine.
# Production: your provider's SMTP URL. REQUIRED when NODE_ENV=production —
# the API refuses to start without it rather than silently drop password-reset
# mail. The URL carries the SMTP password: put the real one only in .env.
SMTP_URL=smtp://mail:1025
MAIL_FROM=TOR Radar <noreply@tor-radar.example>


# -----------------------------------------------------------------------------
# 3. WEB APP
# -----------------------------------------------------------------------------

# How the web SERVER reaches the API. Inside Compose it is the `api` service;
# running both on your machine it is http://localhost:4000. The browser never
# sees this address.
API_BASE_URL=http://api:4000
# How long a page waits for the API before saying the data is unavailable.
API_TIMEOUT_MS=5000

# Host ports, if 4000 or 3000 are already taken on your machine.
API_PORT=4000
# WEB_PORT=3000


# -----------------------------------------------------------------------------
# 4. TESTS — tests write and delete, so they never touch the shared cloud
# -----------------------------------------------------------------------------
# Needed whenever MONGO_URL or storage above point at real cloud services. The
# test setup REFUSES to run against MongoDB Atlas, whatever the database name.

# The Compose mongo service, reached from your machine.
TEST_MONGO_URL=mongodb://localhost:27017/tor_radar_dev
# The Compose storage emulator.
TEST_GCS_API_ENDPOINT=http://localhost:4443
# Tests that make real, BILLED Vertex calls (the extraction benchmark, the live
# adapter test) run only when this is 1 — never merely because a key exists.
RUN_LIVE_VERTEX=


# -----------------------------------------------------------------------------
# 5. SWITCHES — off by default, on purpose
# -----------------------------------------------------------------------------
# Read strictly: true / false, 1 / 0, yes / no, on / off. Anything else is
# refused at start-up rather than guessed.

# Match notification email. OFF until a labelled match-quality benchmark exists
# (profile and matching design §7.8). While off, the notify worker runs in full
# and records what it WOULD send, without sending it.
NOTIFY_DISPATCH_ENABLED=false

# Score matches by where the work is. OFF until extraction captures a work
# location — the issuing agency's province is never used in its place.
MATCH_AREA_SIGNAL_ENABLED=false


# -----------------------------------------------------------------------------
# 6. TUNING — every value has a default in apps/api/src/core/config.ts
# -----------------------------------------------------------------------------
# Shown commented out WITH the default. Uncomment a line only to change it. A
# live copy of every default here would silently override the code, and the two
# would drift apart the first time someone changed one.

# --- Environment --------------------------------------------------------------
# NODE_ENV=development

# --- Accounts and sessions ----------------------------------------------------
# SESSION_LIFETIME_MS=604800000          # 7 days
# ARGON2_MEMORY_KIB=19456
# ARGON2_ITERATIONS=2
# ARGON2_PARALLELISM=1
# AUTH_RATE_LIMIT_PER_IP=60              # per minute
# AUTH_RATE_LIMIT_PER_EMAIL=10           # per minute
# VERIFY_TOKEN_TTL_MS=86400000           # 24 hours
# RESET_TOKEN_TTL_MS=3600000             # 1 hour
# CONSENT_NOTICE_VERSION=2026-10-06
# CONSENT_NOTICE_HASH=notice-not-published

# --- Intake and uploads -------------------------------------------------------
# MAX_UPLOAD_BYTES=26214400              # 25 MiB
# ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/png
# MULTIPART_MAX_FILES=1
# MULTIPART_MAX_FIELD_BYTES=8192
# INTAKE_RATE_LIMIT=60                   # per minute
# FETCH_TIMEOUT_MS=15000
# FETCH_MAX_REDIRECTS=3
# FETCH_MAX_BYTES=26214400
# STORAGE_TIMEOUT_API_MS=10000
# STORAGE_TIMEOUT_WORKER_MS=60000

# --- Extraction jobs ----------------------------------------------------------
# JOB_MAX_ATTEMPTS=5
# JOB_BACKOFF_MS=30000
# JOB_LOCK_MS=120000
# JOB_POLL_MS=2000
# RECONCILE_INTERVAL_MS=60000
# RECONCILE_MIN_AGE_MS=120000
# EXTRACT_TIMEOUT_MS=120000
# EXTRACT_MAX_ANNEXES=4
# EXTRACT_MAX_INPUT_BYTES=14000000
# WORKER_HEALTH_PORT=

# --- Confidence and validation (measured — see docs/corpus/BENCHMARK.md) ------
# T_LOW=0.8
# T_HIGH=0.95
# THRESHOLDS_VERSION=2026-09-03
# BUDGET_MIN_THB=10000
# BUDGET_MAX_THB=100000000000

# --- Dashboard statistics -----------------------------------------------------
# PEER_GROUP_WINDOW_MONTHS=12
# PEER_MIN_N=8
# ANOMALY_METHOD=IQR                     # IQR or ZSCORE — open value O4 (TOR-200)
# ANOMALY_IQR_MULTIPLIER=1.5
# ANOMALY_ZSCORE_LIMIT=3
# STATS_SWEEP_INTERVAL_MS=300000
# STATS_LEASE_MS=60000
# STATS_STALE_AFTER_MS=3600000
# COHORT_TIMEZONE=Asia/Bangkok

# --- Search and admin ---------------------------------------------------------
# SEARCH_PAGE_SIZE=20
# SEARCH_MAX_PAGE_SIZE=100
# SEARCH_QUERY_MAX_CHARS=100
# SEARCH_MAX_FILTER_VALUES=20
# SEARCH_FACET_LIMIT=50
# ADMIN_QUEUE_PAGE_SIZE=25
# TIME_ZONE=Asia/Bangkok                 # whose calendar decides "deadline passed"

# --- Matching -----------------------------------------------------------------
# MATCH_CANDIDATE_CAP=200
# MATCH_CLASSIFY_BATCH=1000
# MATCH_PAGE_SIZE=20
# MATCH_CLASSIFIER_TITLE_SCORE=1
# MATCH_CLASSIFIER_SCOPE_SCORE=0.8
# MATCH_CLASSIFIER_QUALIFICATIONS_SCORE=0.6
# MATCH_CLASSIFIER_AMBIGUITY_MARGIN=0.1
# MATCH_CATEGORY_LEAF_SCORE=1
# MATCH_CATEGORY_GROUP_SCORE=0.8
# MATCH_CATEGORY_COARSE_SCORE=0.6
# MATCH_FREE_TEXT_SCORE=0.4
# MATCH_CATEGORY_WEIGHT=0.7
# MATCH_BUDGET_WEIGHT=0.3
# MATCH_AREA_WEIGHT=0.1
# MATCH_BUDGET_NEUTRAL_SCORE=0.5
# MATCH_BUDGET_INSIDE_SCORE=1
# MATCH_BUDGET_OUTSIDE_MAX_SCORE=0.5
# MATCH_BUDGET_DISTANCE_RANGE_MULTIPLIER=2

# --- Email and notifications --------------------------------------------------
# MAIL_TIMEOUT_MS=10000
# NOTIFY_DISPATCH_INTERVAL_MS=60000
# NOTIFY_DISPATCH_LEASE_MS=55000
# NOTIFY_BATCH_SIZE=100
# NOTIFY_DAILY_BOUNDARY=00:00
# NOTIFY_HIGH_MIN_MATCH=80


# -----------------------------------------------------------------------------
# 7. TOOLS — only for the scripts in tools/
# -----------------------------------------------------------------------------

# SECRET. Jira, for tools/jira.py and tools/jira_seed.py.
# Token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_EMAIL=
JIRA_TOKEN=
