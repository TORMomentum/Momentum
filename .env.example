# Copy to .env for local Docker Compose. Never commit .env.

# --- API ---
# Host port for the api (and the port the browser calls). Change if 4000 is taken locally.
API_PORT=4000
# WEB_PORT=3000

# MongoDB: local compose uses the mongo container; prod points this at MongoDB Atlas.
MONGO_URL=mongodb://mongo:27017/tor_radar

# --- MinIO (raw document storage — raw docs live here, never in Mongo) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=tor-raw

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Vertex AI (Thai OCR / extraction — fill in Sprint 1) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Email notifications (Sprint 3) ---
SMTP_URL=

# --- Jira seeding (tools/jira_seed.py) ---
JIRA_EMAIL=
JIRA_TOKEN=
