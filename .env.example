# Copy to .env for local Docker Compose. Never commit .env.

# --- API ---
# Host port for the api (and the port the browser calls). Change if 4000 is taken locally.
API_PORT=4000
# WEB_PORT=3000

# MongoDB: local compose uses the mongo container; prod points this at MongoDB Atlas.
MONGO_URL=mongodb://mongo:27017/tor_radar

# --- MinIO (raw document storage — raw docs live here, never in Mongo) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-in-local-env
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=tor-raw

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Vertex AI / Document AI (Thai OCR + extraction — TOR-19) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
# Gemini 3.x Flash is "global" only; 2.5-flash also runs in us-central1 / asia-southeast1.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Document AI is multi-region only: "us" or "eu"
DOCAI_LOCATION=us
# Document OCR processor id (create in Document AI console) — needed for TOR-20
DOCAI_PROCESSOR_ID=

# --- Email notifications (Sprint 3) ---
SMTP_URL=

# --- Jira seeding (tools/jira_seed.py) ---
JIRA_EMAIL=
JIRA_TOKEN=

# Server-side base URL the web app uses to reach the API. The browser never
# sees this or the admin key: admin requests go through the Next server.
API_BASE_URL=http://api:4000

# Shared secret used only to establish a signed staff session in the Next server.
# Leave empty to deny all staff access; set a strong, unique value in each environment.
STAFF_ACCESS_SECRET=
