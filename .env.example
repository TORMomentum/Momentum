# Copy to .env for local Docker Compose. Never commit .env.

# --- API ---
# Host port for the api (and the port the browser calls). Change if 4000 is taken locally.
API_PORT=4000
# WEB_PORT=3000

# --- Accounts and sessions ---
# Required: use a unique, high-entropy value of at least 32 characters.
SESSION_SECRET=
SESSION_LIFETIME_MS=604800000
ARGON2_MEMORY_KIB=19456
ARGON2_ITERATIONS=2
ARGON2_PARALLELISM=1
AUTH_RATE_LIMIT_PER_IP=60
AUTH_RATE_LIMIT_PER_EMAIL=10

# MongoDB: local compose uses the mongo container; prod points this at MongoDB Atlas.
# Tests never use this database directly: vitest.setup.ts forces the name to end
# in _test before any suite loads, so `npm test` cannot wipe development data.
MONGO_URL=mongodb://mongo:27017/tor_radar

# --- Object storage — Google Cloud Storage (docs/superpowers/specs/2026-09-14-object-storage-gcs-design.md) ---
GCS_BUCKET=tor-raw
# Emulator only. Leave unset in deployment.
GCS_API_ENDPOINT=http://localhost:4443
# Deployment only: the DEDICATED storage service account's key. Never Vertex AI's —
# one compromised key must not carry both powers. Keys live in ./secrets/, which
# .gitignore covers twice (the directory, and the *-sa.json pattern); the value
# here is a PATH, never key material.
GCS_CREDENTIALS=./secrets/gcs-storage-sa.json
STORAGE_TIMEOUT_API_MS=10000
STORAGE_TIMEOUT_WORKER_MS=60000

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Vertex AI / Document AI (Thai OCR + extraction — TOR-19) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
# Gemini 3.x Flash is "global" only; 2.5-flash also runs in us-central1 / asia-southeast1.
VERTEX_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Document AI is multi-region only: "us" or "eu"
DOCAI_LOCATION=us
# Document OCR processor id (create in Document AI console) — needed for TOR-20
DOCAI_PROCESSOR_ID=

# --- Dashboard statistics ---
PEER_GROUP_WINDOW_MONTHS=12
PEER_MIN_N=8
# Open value O4: IQR is provisional until compared with ZSCORE on real budgets.
ANOMALY_METHOD=IQR
ANOMALY_IQR_MULTIPLIER=1.5
ANOMALY_ZSCORE_LIMIT=3
STATS_SWEEP_INTERVAL_MS=300000
STATS_LEASE_MS=60000
STATS_STALE_AFTER_MS=3600000
COHORT_TIMEZONE=Asia/Bangkok

# --- Email notifications (Sprint 3) ---
SMTP_URL=

# --- Jira seeding (tools/jira_seed.py) ---
JIRA_EMAIL=
JIRA_TOKEN=

# Server-side base URL the web app uses to reach the API. The browser never
# sees this or the admin key: admin requests go through the Next server.
API_BASE_URL=http://api:4000
# How long the web server waits for the API before a page says the data is unavailable.
API_TIMEOUT_MS=5000

# --- Public search (TOR-40). Defaults shown; every one is optional. ---
SEARCH_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=100
SEARCH_QUERY_MAX_CHARS=100
SEARCH_MAX_FILTER_VALUES=20
SEARCH_FACET_LIMIT=50
# Whose calendar decides whether a submission deadline has passed.
TIME_ZONE=Asia/Bangkok

# Shared secret used only to establish a signed staff session in the Next server.
# Leave empty to deny all staff access; set a strong, unique value in each environment.
STAFF_ACCESS_SECRET=
